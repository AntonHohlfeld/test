<Window x:Class="Overlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay" Width="420" Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="True">
    <Border Background="#AA111111" CornerRadius="10" Padding="10">
        <StackPanel>
            <TextBlock Text="iRacing Overlay (Vertical Slice)" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="RelativeAheadText" Foreground="White" Margin="0,8,0,0"/>
            <TextBlock x:Name="RelativeBehindText" Foreground="White"/>
            <TextBlock x:Name="FuelText" Foreground="#FFE6C84F" Margin="0,8,0,0"/>
            <TextBlock x:Name="FlagsText" Foreground="#FF7FD1FF"/>
            <TextBlock x:Name="PerfText" Foreground="#FF8DFF8D" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
